# ----------------------------------------------------------------------------
# Horus Cyber Agent - Backend environment configuration
# Copy this file to ".env" and fill in the values you need.
# ----------------------------------------------------------------------------

# Port the Express API listens on.
PORT=5174

# Comma separated list of origins allowed to call the API (CORS).
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# LLM provider (OPTIONAL).
# Horus runs fully in "offline" template mode with no key. Add a key to enable
# live AI responses. The safety filter is ALWAYS applied, key or not.
# Supported providers: "anthropic" | "openai" | "offline"
# ---------------------------------------------------------------------------
LLM_PROVIDER=offline

# Anthropic (Claude) configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI configuration (only used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Command runner safety
# The runner ONLY ever executes commands on this allowlist (see allowlist.ts).
# Set to "false" to disable the command runner entirely.
# ---------------------------------------------------------------------------
ENABLE_COMMAND_RUNNER=true

# Working directory the command runner is locked to (must exist).
COMMAND_WORKSPACE=./workspace

# Per command timeout in milliseconds.
COMMAND_TIMEOUT_MS=20000
