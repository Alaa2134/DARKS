<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Neptune Remote</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad multitasking requires all four orientations unless the app opts out
	     of it. The layout is built for a phone held any way up, so supporting
	     them is simpler and more useful than requiring full screen. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>

	<!-- Moonraker and the backend are plain HTTP over Tailscale, which is
	     already an encrypted WireGuard tunnel. ATS is relaxed for arbitrary
	     hosts because the Pi's address is user-configurable.

	     NSAllowsArbitraryLoads MUST BE THE ONLY KEY IN THIS DICTIONARY.

	     Apple ignores NSAllowsArbitraryLoads - falling back to its default of
	     NO - whenever NSAllowsLocalNetworking, NSAllowsArbitraryLoadsInWebContent
	     or NSAllowsArbitraryLoadsForMedia is also present and the app is linked
	     against the iOS 10+ SDK. This file used to carry NSAllowsLocalNetworking
	     as well, which silently disabled arbitrary loads and left only the
	     local-network allowance. Tailscale hands out CGNAT addresses in
	     100.64.0.0/10, which is not a local network as far as ATS is concerned,
	     so every plain-HTTP request to the Pi failed with
	     NSURLErrorAppTransportSecurityRequiresSecureConnection (-1022) while
	     Safari - which is not subject to this app's ATS policy - loaded the very
	     same URL.

	     Arbitrary loads already covers everything NSAllowsLocalNetworking would
	     have permitted, so nothing is lost by dropping it. Do not "restore" that
	     key: it re-breaks HTTP over Tailscale.

	     ATSPolicyTests and scripts/build_unsigned_ipa.sh both assert this. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<key>NSLocalNetworkUsageDescription</key>
	<string>Neptune Remote connects to your Raspberry Pi to control the printer. On the same Wi-Fi it uses your local network; remotely it uses Tailscale.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Not used by this app. The printer camera stream comes from the Raspberry Pi over the network.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save a snapshot of the printer camera to your photo library.</string>

	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Lock screen / Dynamic Island print progress. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pick a photo of a finished print to use as the model's picture.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.neptune.remote</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>neptuneremote</string>
			</array>
		</dict>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- iOS ships no system type for STL, OBJ or 3MF. Without these
	     declarations `UTType(filenameExtension: "stl")` returns a *dynamic*
	     type (dyn.ah62d4...), and a dynamic type never matches the type the
	     Files app assigns to a real file - so every .stl in the picker is
	     greyed out and cannot be selected.

	     Declaring them as imported types gives the extensions a concrete UTI
	     that both the picker and Open-in resolve against. STL is listed both
	     as text and binary because the format has both encodings and the app
	     must accept either. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>public.standard-tesselated-geometry-format</string>
			<key>UTTypeDescription</key>
			<string>STL 3D Model</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.3d-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>stl</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>model/stl</string>
					<string>application/sla</string>
					<string>application/vnd.ms-pki.stl</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.3mf.3dmanufacturing</string>
			<key>UTTypeDescription</key>
			<string>3MF 3D Model</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.3d-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>3mf</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>model/3mf</string>
					<string>application/vnd.ms-package.3dmanufacturing-3dmodel+xml</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>public.geometry-definition-format</string>
			<key>UTTypeDescription</key>
			<string>OBJ 3D Model</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.3d-content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>obj</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>model/obj</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.neptune.remote.gcode</string>
			<key>UTTypeDescription</key>
			<string>G-code</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>gcode</string>
					<string>gco</string>
					<string>g</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>text/x.gcode</string>
				</array>
			</dict>
		</dict>
	</array>

	<!-- Lets the app appear in the Share sheet and in "Open With" for these
	     files, which is the other half of getting a model in. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>3D Model</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.standard-tesselated-geometry-format</string>
				<string>org.3mf.3dmanufacturing</string>
				<string>public.geometry-definition-format</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>G-code</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.neptune.remote.gcode</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
