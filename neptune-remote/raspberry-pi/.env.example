# ---------------------------------------------------------------------------
# Neptune 3 Plus Remote - backend environment overrides
#
#   cp .env.example .env
#   nano .env
#
# .env is git-ignored and is read from the directory that holds config.yaml.
# Anything set here overrides config.yaml, so it is the right place for secrets.
# ---------------------------------------------------------------------------

# --- server ---------------------------------------------------------------
# NEPTUNE_HOST=0.0.0.0
# NEPTUNE_PORT=8710
# Shared secret required in the X-API-Key header (leave unset to rely on Tailscale only)
# NEPTUNE_API_TOKEN=
# NEPTUNE_LOG_LEVEL=info

# --- moonraker ------------------------------------------------------------
# NEPTUNE_MOONRAKER_HOST=127.0.0.1
# NEPTUNE_MOONRAKER_PORT=7125
# NEPTUNE_MOONRAKER_API_KEY=

# --- storage --------------------------------------------------------------
# NEPTUNE_DATA_DIR=~/neptune-remote-data
# NEPTUNE_PROFILES_DIR=/opt/neptune-remote/profiles

# --- slicer ---------------------------------------------------------------
# NEPTUNE_SLICER_ENGINE=prusaslicer
# NEPTUNE_PRUSASLICER_BIN=prusa-slicer
# NEPTUNE_ORCASLICER_BIN=orca-slicer

# --- power ----------------------------------------------------------------
# tuya | moonraker | webhook | demo | none
# NEPTUNE_POWER_PROVIDER=tuya
# NEPTUNE_POWER_MOONRAKER_DEVICE=printer

# --- Tuya / Smart Life (see docs/TUYA_SETUP.md) ----------------------------
# NEPTUNE_TUYA_ENABLED=true
# NEPTUNE_TUYA_ACCESS_ID=
# NEPTUNE_TUYA_ACCESS_SECRET=
# NEPTUNE_TUYA_DEVICE_ID=
# NEPTUNE_TUYA_ENDPOINT=https://openapi.tuyaeu.com
# NEPTUNE_TUYA_SWITCH_CODE=switch_1
